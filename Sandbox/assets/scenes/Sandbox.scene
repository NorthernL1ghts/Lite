name: Sandbox
planes:
  - name: Background
    order: 0
    entities:
      - name: Checkerboard
        transform:
          position: [0, 0, 0]
          rotation: 0
          scale: [10, 6, 1]
        mesh:
          type: sprite
        material:
          shader: Batch
          color: [1, 1, 1, 1]
          tiling: [6, 4]
          texture: Checkerboard.png
          vertex-colors: false
          roughness: 0.35
        sorting:
          order: -10
  - name: World
    order: 1
    entities:
      - name: Camera
        transform:
          position: [0, 0, 0]
          rotation: 0
          scale: [1, 1, 1]
        camera:
          projection: orthographic
          size: 5
          fov: 1.0472
          near: -1
          far: 1
          primary: true
      - name: Perspective
        transform:
          position: [0, 0, 0]
          rotation: 0
          scale: [1, 1, 1]
        camera:
          projection: perspective
          size: 5
          fov: 1.0472
          near: 0.1
          far: 50
          primary: false
      - name: Ground
        prefab: prefabs/Ground.prefab
        transform:
          position: [0, -2.05, 0]
          rotation: 0
          scale: [8, 0.22, 1]
        mesh:
          type: quad
        material:
          shader: Batch
          color: [0.22, 0.24, 0.28, 1]
          tiling: [1, 1]
          vertex-colors: false
        rigidbody2d:
          type: static
          mass: 1
          gravity: 1
          velocity: [0, 0]
          angular: 0
          freeze: true
        box-collider2d:
          size: [1, 1]
          offset: [0, 0]
          trigger: false
        sorting:
          order: 0
      - name: Crate
        prefab: prefabs/Crate.prefab
        transform:
          position: [-1.55, 1.4, 0]
          rotation: 0
          scale: [0.52, 0.52, 1]
        mesh:
          type: quad
        material:
          shader: Batch
          color: [0.86, 0.16, 0.18, 1]
          tiling: [1, 1]
          vertex-colors: false
          roughness: 0.3
          metallic: 0.75
        rigidbody2d:
          type: dynamic
          mass: 1
          gravity: 1
          velocity: [0, 0]
          angular: 0
          freeze: false
        box-collider2d:
          size: [1, 1]
          offset: [0, 0]
          trigger: false
        script:
          class: Bounce
        sorting:
          order: 4
      - name: Ball
        prefab: prefabs/Ball.prefab
        transform:
          position: [0.45, 1.85, 0]
          rotation: 0
          scale: [0.4, 0.4, 1]
        mesh:
          type: quad
        material:
          shader: Batch
          color: [0.2, 0.45, 0.95, 1]
          tiling: [1, 1]
          vertex-colors: false
          roughness: 0.15
          metallic: 0.4
        rigidbody2d:
          type: dynamic
          mass: 0.45
          gravity: 0.45
          velocity: [0, 0]
          angular: 0
          freeze: false
        circle-collider2d:
          radius: 0.5
          offset: [0, 0]
          trigger: false
        sorting:
          order: 5
      - name: Spinner
        transform:
          position: [2.75, 0.15, 0]
          rotation: 0
          scale: [0.9, 0.9, 1]
        mesh:
          type: triangle
        material:
          shader: Batch
          color: [1, 1, 1, 1]
          tiling: [1, 1]
          vertex-colors: true
          colors:
            - [0.93, 0.22, 0.28, 1]
            - [0.08, 0.78, 0.42, 1]
            - [0.16, 0.36, 0.96, 1]
            - [1, 1, 1, 1]
          roughness: 0.2
        spin:
          rate: 1.8
        rigidbody2d:
          type: kinematic
          mass: 1
          gravity: 0
          velocity: [0, 0]
          angular: 0
          freeze: false
        sorting:
          order: 6
      - name: Carrier
        transform:
          position: [0, -0.75, 0]
          rotation: 0
          scale: [1, 1, 1]
      - name: Platform
        parent: 7
        transform:
          position: [0, 0, 0]
          rotation: 0
          scale: [1.8, 0.18, 1]
        mesh:
          type: quad
        material:
          shader: Batch
          color: [0.28, 0.62, 0.4, 1]
          tiling: [1, 1]
          vertex-colors: false
        rigidbody2d:
          type: kinematic
          mass: 1
          gravity: 0
          velocity: [0, 0]
          angular: 0
          freeze: true
        script:
          class: Patrol
        box-collider2d:
          size: [1, 1]
          offset: [0, 0]
          trigger: false
        sorting:
          order: 1
      - name: Flag
        parent: 8
        transform:
          position: [0.72, 0.34, 0]
          rotation: 0
          scale: [0.14, 0.48, 1]
        mesh:
          type: quad
        material:
          shader: Batch
          color: [0.93, 0.45, 0.12, 1]
          tiling: [1, 1]
          vertex-colors: false
        sorting:
          order: 3
      - name: Sensor
        transform:
          position: [1.15, -0.75, 0]
          rotation: 0
          scale: [0.42, 1.2, 1]
        mesh:
          type: quad
        material:
          shader: Batch
          color: [0.95, 0.78, 0.25, 0.35]
          tiling: [1, 1]
          vertex-colors: false
        rigidbody2d:
          type: static
          mass: 1
          gravity: 1
          velocity: [0, 0]
          angular: 0
          freeze: true
        box-collider2d:
          size: [1, 1]
          offset: [0, 0]
          trigger: true
        script:
          class: Sensor
        sorting:
          order: 2
  - name: Foreground
    order: 2
    entities:
      - name: Overlay
        transform:
          position: [2.75, 0.42, 0]
          rotation: 0
          scale: [1.6, 0.18, 1]
        mesh:
          type: quad
        material:
          shader: Batch
          color: [0.18, 0.42, 0.78, 1]
          tiling: [1, 1]
          vertex-colors: false
          emission: 0.6
        sorting:
          order: 0
